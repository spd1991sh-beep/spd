{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spd",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3a71236c-9444-42eb-a4eb-37bbedf12764","database_name": "spd" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e2750363222e4ea0b30041360bb65465" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
